<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's figures on their own, for the status bar, which shows a
     notification's icon as a shape and nothing else: favicon.svg's path data,
     placed by the group so that what the hourglass covers - 142 to 418 across,
     121 to 439 down - fills the middle of the icon with a little room around
     it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="560"
    android:viewportHeight="560">
    <group
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:translateX="-140"
        android:translateY="-140">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M142.15 120.62H417.85L280 280Z" />
        <path
            android:fillAlpha="0.55"
            android:fillColor="#FFFFFF"
            android:pathData="M142.15 439.38H417.85L280 280Z" />
    </group>
</vector>
